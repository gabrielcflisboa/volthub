{
  "name": "bff-web",
  "version": "1.0.0",
  "description": "Backend for Frontend do app VoltHub: autenticação, agregação, resiliência e tempo real (WebSocket)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --import ./dist/telemetry.js dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.3.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.57.1",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.200.0",
    "@opentelemetry/sdk-logs": "^0.200.0",
    "@opentelemetry/sdk-node": "^0.200.0",
    "fastify": "^5.12.5",
    "jose": "^5.10.0",
    "kafkajs": "^2.2.4",
    "opossum": "^8.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/opossum": "^8.1.9",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "5.8"
  }
}
