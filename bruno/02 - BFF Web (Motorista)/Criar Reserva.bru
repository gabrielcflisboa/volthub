meta {
  name: Criar Reserva
  type: http
  seq: 5
}

post {
  url: {{bffUrl}}/api/v1/reservations
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{driverToken}}
}

body:json {
  {
    "chargerId": "{{defaultChargerId}}"
  }
}

vars:pre-request {
  defaultChargerId: BH-CNF-01
}

vars:post-response {
  activeReservationId: res.body.id
}
