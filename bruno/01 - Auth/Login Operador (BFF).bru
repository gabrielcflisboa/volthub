meta {
  name: Login Operador (BFF)
  type: http
  seq: 4
}

post {
  url: {{bffUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "operador@volthub.com",
    "password": "operador123"
  }
}

vars:post-response {
  operatorToken: res.body.accessToken
}
